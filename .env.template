# ── Required ─────────────────────────────────────────────────────────────
# Sarvam AI streaming STT/translate API key.
# Get one at https://dashboard.sarvam.ai/ — the same key drives Saaras
# (speech-to-text + translate-mode) and Mayura (text translation).
SARVAM_API_KEY=

# ── Branding ─────────────────────────────────────────────────────────────
# APP_NAME shows in the browser title and operator header.
# ACCENT_COLOR (hex or CSS colour) drives the highlight used for buttons,
# focus rings, and the "switching…" chip border.
# APP_NAME=Live Captions
# ACCENT_COLOR=#FF8C00

# ── Default direction ────────────────────────────────────────────────────
# Sarvam language codes used to pre-fill the source/target dropdowns on
# first load. Common codes: en-IN, hi-IN, gu-IN, ta-IN, kn-IN, te-IN,
# ml-IN, mr-IN, pa-IN, bn-IN, od-IN. See README for the full list.
# This fork's own default (in live_captions.py) is already pinned to
# gu-IN → en-IN, the katha's fixed direction — override here only if this
# deployment needs a different pair.
# DEFAULT_SOURCE_LANG=gu-IN
# DEFAULT_TARGET_LANG=en-IN

# ── Keep-alive through silence ───────────────────────────────────────────
# A frame of digital silence sent every SARVAM_KEEPALIVE_SEC while the audio
# gate is closed, so a long pause can't idle the Sarvam connection out. Leave
# both alone unless a session is dropping during silences.
#
# The interval must be greater than 0 and no more than 30 seconds, which is
# half the 60 s window the tool sizes itself against. That 60 s is a
# deliberately pessimistic assumption, NOT a published Sarvam figure —
# measured on 2026-08-31, idle connections survived three minutes four times
# out of five, so there is no reliable idle timeout to quote. Anything outside
# the range is ignored with a warning and the 20 s default used.
# Set SARVAM_KEEPALIVE=off to disable it entirely.
# SARVAM_KEEPALIVE=on
# SARVAM_KEEPALIVE_SEC=20

# ── ProPresenter (only when --propresenter is passed) ────────────────────
# Host + port of the ProPresenter remote/network API. Live FINAL captions
# are written to a Message named "Live Caption" (auto-created).
# PP_HOST=127.0.0.1
# PP_PORT=49566

# ── VOD reprocessing (used by tools/reprocess_vod.py + Reprocess tab) ────
# Google Cloud project + bucket where audio is uploaded for Speech-to-Text.
# See REPROCESS_VOD.md for one-time GCP setup.
# GCP_PROJECT=
# GCS_BUCKET=

# ── YouTube CC migration shim ────────────────────────────────────────────
# Legacy single-stream-key env var. On first run it's seeded as feed #1
# in outputs.json — after that, manage feeds from the Outputs tab in the UI.
# YOUTUBE_STREAM_KEY=

# ── Caption assembly ─────────────────────────────────────────────────────
# A caption is a sentence, not a speech-detector segment. Off restores the
# previous per-utterance behaviour exactly — the revert path on the day.
# CAPTION_SENTENCE_MODE=on
# CAPTION_SENTENCE_QUIET_SEC=2.5        # silence after which the speaker has stopped
# CAPTION_SENTENCE_MAX_WAIT_SEC=8.0     # ceiling on how stale a caption may be
# CAPTION_SENTENCE_MAX_CHARS=180        # readability ceiling, not storage. Raising it re-opens a live fault.
# CAPTION_SENTENCE_MIN_WORDS=5          # below this, a full stop is a segment artefact
# CAPTION_SENTENCE_DRAIN_SEC=10.0       # how long a closing session publishes for

# ── Translation ──────────────────────────────────────────────────────────
# "gemini" (the default) or "sarvam". Anything else is rejected at startup
# with an ERROR and falls back to gemini — a typo here used to buy the slow
# two-hop pipeline, deliver Sarvam's captions, and still print "Translator:
# Gemini" in the log.
#
# Choosing gemini forces the two-hop pipeline, because an external translator
# needs the source text — so the source language is recorded too.
# CAPTION_TRANSLATOR=gemini            # default. "sarvam" selects MAYURA for the
#                                     # translation. Sarvam does the LISTENING either
#                                     # way — this setting does not change that.
# GEMINI_API_KEY=                       # required for gemini; never commit it
# GEMINI_MODEL=gemini-3.1-flash-lite    # gemini-2.5-flash is withdrawn (404)
# GEMINI_TIMEOUT_SEC=5.0                # past this, the Sarvam translator answers
# GEMINI_CONTEXT_LINES=3                # prior lines sent for pronoun continuity
# GEMINI_MAX_OUTPUT_TOKENS=256
# CAPTION_GLOSSARY=glossary.json        # domain brief + term renderings

# ── Stopping the server ──────────────────────────────────────────────────────
# A stray Ctrl+C in the server's console used to end the captions instantly,
# and twice did exactly that during a live katha (issue #61). It is now
# refused, and this is how many presses inside two seconds it takes to exit
# deliberately. Set it to 0 on a control-room machine: nothing at the keyboard
# can then stop the captions, and stop-captions is the way out either way.
# A value that is not a whole number costs the default, never the boot.
# CAPTION_INTERRUPT_PRESSES=3

# Record the source-language transcript beside the translation. Costs an
# extra call per line; the only way to tell a mishearing from a
# mistranslation after the fact.
# SARVAM_RECORD_SOURCE=off
